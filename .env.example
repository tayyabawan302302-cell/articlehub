# Supabase — from your Supabase project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the client

# Site
NEXT_PUBLIC_SITE_URL=https://articlehub.com

# Analytics / Ads (also editable live from Admin > Settings — these are fallback defaults)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
